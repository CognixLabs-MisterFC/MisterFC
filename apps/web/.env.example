# MisterFC — env vars de apps/web
#
# Copia este archivo a `apps/web/.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore — nunca se commitea.

# ─── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sentry ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN: DSN del proyecto en sentry.io. Para MisterFC apunta
# al proyecto cuyo slug es `javascript-nextjs` (project id 4511458093432912).
# Sin esta var, el SDK NO inicializa y los Sentry.captureException son no-ops.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=mister-fc
# SENTRY_PROJECT: slug real del proyecto en sentry.io. Usado por
# `withSentryConfig` solo para upload de source maps. NO afecta a la captura
# de eventos (esa la controla NEXT_PUBLIC_SENTRY_DSN). El slug correcto en
# Cognix Labs es `javascript-nextjs` (no `misterfc-web`).
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=

# ─── Sitio ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL: URL pública del sitio, sin barra final. Opcional: sin
# ella vale `https://misterfc.es`. Se usa en el sitemap, robots, canonical y
# hreflang; en local solo hace falta si quieres que apunten a localhost.
NEXT_PUBLIC_SITE_URL=

# ─── Interruptores de despliegue ───────────────────────────────────────────
# SUBSCRIPTION_GATE y FAMILY_WEB_CUT se envían APAGADOS: solo actúan con el
# valor exacto `on`, así que ausente o vacío = apagado. No se tocan hasta el
# día de la publicación. MARKETING_SITE va aparte (ver abajo).
#
# SUBSCRIPTION_GATE (SU-5): muro de suscripción de la web. Tiene GEMELA en el
# build de EAS (`EXPO_PUBLIC_SUBSCRIPTION_GATE`) y las dos se encienden JUNTAS;
# con solo una, la misma familia ve cosas distintas en la web y en el móvil.
SUBSCRIPTION_GATE=
#
# FAMILY_WEB_CUT (W-B): cierra la web a las familias y a los seguidores, que
# pasan a usar la app. NO tiene gemela: la app es el destino del corte, no la
# otra mitad de un muro, y no se entera de nada. El staff y la dirección no se
# ven afectados. Quedan abiertos /invite/{token}, los textos legales, la
# eliminación de cuenta y /re-consentimiento (que hoy solo existe en la web).
FAMILY_WEB_CUT=
#
# MARKETING_SITE: web comercial de misterfc.es (portada, funciones, seguridad,
# demo). OJO, esta NO sigue la regla de las otras dos: `on` la enciende y `off`
# la apaga en cualquier entorno; vacía, se enciende SOLO en las vistas previas de
# Vercel (`VERCEL_ENV=preview`). En local, vacía = apagada; pon `on` para verla.
# En Vercel va solo en Production. Está declarada en turbo.json: el build tiene
# que verla (sitemap y legales de la web se generan al compilar).
MARKETING_SITE=

# ─── Resend (correos de invitación) ────────────────────────────────────────
# Correo-B1. Los correos de invitación los manda la app por la API de Resend, no
# GoTrue: es lo que permite escribirlos en el idioma del destinatario
# (`profiles.locale`), porque la plantilla del dashboard de Supabase no puede
# leerlo y salía todo en castellano.
#
# Cómo se consigue: resend.com → API Keys → Create API Key, permiso "Sending
# access" sobre el dominio misterfc.es (ya verificado: es el mismo que usa el
# relay SMTP de Supabase). Empieza por `re_`.
#
# Va también en Vercel (Production, Preview y Development). Sin ella NO se manda
# ningún correo de invitación y el envío devuelve error — nunca un éxito mudo.
RESEND_API_KEY=

# A-2. El *signing secret* del webhook de entrega: es lo que nos entera de que un
# correo de invitación NO llegó. Sin esto, invitar a una dirección que no existe
# devuelve id, la pantalla dice "Invitación enviada" y el club acaba persiguiendo a
# una familia que nunca recibió nada.
#
# Cómo se consigue: resend.com → Webhooks → Add Webhook, apuntando a
# `https://misterfc.es/api/webhooks/resend`, con los eventos `email.sent`,
# `email.delivered`, `email.bounced`, `email.complained`, `email.delivery_delayed` y
# `email.failed`. El secreto que sale al crearlo empieza por `whsec_`.
#
# Va en Vercel (Production; en Preview solo si vas a apuntar un webhook ahí). Sin él
# el endpoint responde 401 a TODO, que es lo que queremos: un webhook sin verificar
# dejaría que cualquiera que sepa la URL marque invitaciones buenas como rebotadas,
# o tape un rebote de verdad poniéndolo en "entregado".
RESEND_WEBHOOK_SECRET=

# ─── Formulario de demo de la web comercial ────────────────────────────────
# Opcionales. Sin ellas, el aviso de cada solicitud va a `info.cognixlabs@gmail.com`
# (que es también el Reply-To del acuse a quien la pide) y sale desde
# `MisterFC <demo@misterfc.es>`. El remitente tiene que ser del dominio
# verificado en Resend (misterfc.es). Usan la misma RESEND_API_KEY.
DEMO_TO=
DEMO_FROM=

# ─── Crons de Vercel ───────────────────────────────────────────────────────
# CRON_SECRET: lo pone Vercel en `Authorization: Bearer …` al llamar a las rutas
# de `/api/cron/*` (apps/web/vercel.json). Sin él, esas rutas responden 401 a
# todo. Para probar un cron en local: cualquier valor, y llamarlo con esa
# cabecera.
CRON_SECRET=

# ─── Notificaciones push de la web (VAPID) ─────────────────────────────────
# El par se genera con `npx web-push generate-vapid-keys` (ADR-0010). La pública
# va al navegador; la privada, solo en el servidor. Sin el par, el panel de
# notificaciones no puede suscribirse y el envío de push falla con error.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT: contacto que ven los servicios de push. Opcional; sin ella vale
# `mailto:admin@misterfc.app`.
VAPID_SUBJECT=

# ─── Suscripciones (RevenueCat) ────────────────────────────────────────────
# REVENUECAT_SECRET_KEY: clave secreta de la API de RevenueCat (solo servidor).
# Sin ella no se reconcilian ni se reclaman suscripciones, y queda en Sentry.
REVENUECAT_SECRET_KEY=
# REVENUECAT_WEBHOOK_SECRET: firma del webhook de RevenueCat
# (`/api/webhooks/revenuecat`). Sin ella el webhook responde 401 a todo, a
# propósito: un webhook sin verificar podría regalar acceso de pago.
REVENUECAT_WEBHOOK_SECRET=
