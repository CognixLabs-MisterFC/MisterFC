{
  "name": "native",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo .turbo dist"
  },
  "expo": {
    "install": {
      "//": "react y typescript los pinea el monorepo (compartidos con apps/web); se excluyen de la validación de versiones de Expo para no forzar un downgrade cross-workspace.",
      "exclude": [
        "react",
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@misterfc/core": "workspace:*",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~56.0.17",
    "expo-constants": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.16",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "nativewind": "^4.2.6",
    "react": "19.2.4",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^19",
    "babel-preset-expo": "~56.0.18",
    "eslint": "^9",
    "eslint-config-expo": "~56.0.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
