{
  "name": "native",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo .turbo dist"
  },
  "expo": {
    "install": {
      "//": "react y typescript los pinea el monorepo (compartidos con apps/web); se excluyen de la validación de versiones de Expo para no forzar un downgrade cross-workspace.",
      "exclude": [
        "react",
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@misterfc/core": "workspace:*",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.4",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^19",
    "babel-preset-expo": "~57.0.4",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}
