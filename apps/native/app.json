{
  "expo": {
    "name": "MisterFC",
    "slug": "misterfc",
    "owner": "misterfc",
    "scheme": "misterfc",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.misterfc.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:misterfc.es"
      ]
    },
    "android": {
      "package": "com.misterfc.app",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#438832"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "misterfc.es",
              "pathPrefix": "/es/invite"
            },
            {
              "scheme": "https",
              "host": "misterfc.es",
              "pathPrefix": "/en/invite"
            },
            {
              "scheme": "https",
              "host": "misterfc.es",
              "pathPrefix": "/va/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "@sentry/react-native",
        {
          "organization": "mister-fc",
          "project": "misterfc-native",
          "experimental_android": {
            "enableAndroidGradlePlugin": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#438832",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#438832"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#438832"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MisterFC accede a tus fotos para actualizar la foto del jugador."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "808b74cb-58d8-4633-97a6-caaf57c4c5e6"
      }
    }
  }
}
